<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widget_body"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/widget_ring"
            android:layout_width="84dp"
            android:layout_height="84dp"
            android:contentDescription="@string/widget_streak_description" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_today"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/google_sans_bold"
                android:textColor="@color/white"
                android:textSize="15sp"
                tools:text="Today 3/5" />

            <TextView
                android:id="@+id/widget_goal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/google_sans_regular"
                android:textColor="#8B949E"
                android:textSize="13sp"
                tools:text="Goal 3" />

            <TextView
                android:id="@+id/widget_best"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/google_sans_regular"
                android:textColor="#8B949E"
                android:textSize="12sp"
                android:visibility="gone"
                tools:text="Best 14 · 96 done"
                tools:visibility="visible" />

        </LinearLayout>

        <ImageView
            android:id="@+id/widget_tick"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/widget_tick_bg"
            android:contentDescription="@string/widget_tick_description"
            android:padding="8dp"
            android:src="@drawable/add" />

    </LinearLayout>

    <ImageView
        android:id="@+id/widget_heatmap"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:layout_weight="1"
        android:contentDescription="@string/widget_heatmap_description"
        android:scaleType="fitStart"
        android:visibility="gone"
        tools:visibility="visible" />

</LinearLayout>
