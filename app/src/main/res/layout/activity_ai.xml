<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    tools:context=".AiActivity">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scrollbars="none">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- The wordmark is live text in brand yellow, not an asset: no bitmap
                 ships and the type scales with the font. includeFontPadding=false
                 in the appearance makes the box hug the caps, which keeps the
                 "Powered by AI" line a fixed gap under it instead of riding on
                 font leading. match_parent inside the 18dp margins (not
                 wrap_content) so that at a large accessibility font size the
                 glyphs ellipsize inside the content width rather than run off
                 the screen edge. -->
            <TextView
                android:id="@+id/wordmark"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentTop="true"
                android:layout_marginHorizontal="18dp"
                android:layout_marginTop="15dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="MOMENTUM+"
                android:textAppearance="@style/TextAppearance.Momentum.Wordmark" />

            <TextView
                android:id="@+id/ai_txt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/wordmark"
                android:layout_marginStart="18dp"
                android:layout_marginTop="6dp"
                android:fontFamily="@font/google_sans_regular"
                android:text="Powered by AI"
                android:textColor="@color/secondary_text"
                android:textSize="14sp" />

            <!-- ANSWER CARD -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/questions_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/ai_txt"
                android:layout_marginHorizontal="18dp"
                android:layout_marginTop="10dp"
                android:foreground="?attr/selectableItemBackground"
                android:visibility="visible"
                app:cardCornerRadius="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:weightSum="2">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:layout_marginEnd="10dp"
                            android:layout_weight="1.1"
                            android:text="Get your personalized habits, but first..."
                            android:textAppearance="@style/TextAppearance.Momentum.ItemTitle" />

                        <com.airbnb.lottie.LottieAnimationView
                            android:layout_width="250dp"
                            android:layout_height="150dp"
                            android:layout_marginTop="-13dp"
                            android:layout_weight="0.9"
                            app:lottie_autoPlay="true"
                            app:lottie_loop="true"
                            app:lottie_rawRes="@raw/ai_robot" />

                    </LinearLayout>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/answer_btn"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clickable="false"
                        android:focusable="false"
                        app:cardBackgroundColor="@color/streak_yellow"
                        app:cardCornerRadius="20dp"
                        app:cardElevation="0dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/google_sans_bold"
                            android:gravity="center"
                            android:paddingVertical="16dp"
                            android:text="Answer a few questions"
                            android:textColor="@color/black"
                            android:textSize="16sp" />

                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- FREE TEXT PROMPT -->
            <LinearLayout
                android:id="@+id/free_prompt_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/questions_card"
                android:layout_marginHorizontal="18dp"
                android:layout_marginTop="18dp"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Or just describe what you want to work on"
                    android:textAppearance="@style/TextAppearance.Momentum.BodySecondary"
                    android:textSize="15sp" />

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    app:boxBackgroundColor="@color/dark_grey"
                    app:boxCornerRadiusBottomEnd="16dp"
                    app:boxCornerRadiusBottomStart="16dp"
                    app:boxCornerRadiusTopEnd="16dp"
                    app:boxCornerRadiusTopStart="16dp"
                    app:hintTextColor="@color/secondary_text">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/free_prompt_input"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/google_sans_regular"
                        android:gravity="top"
                        android:hint="e.g. I want to be healthier and more focused"
                        android:inputType="textMultiLine"
                        android:minLines="3"
                        android:textColor="@color/white"
                        android:textColorHint="@color/secondary_text"
                        android:textSize="16sp" />

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/generate_btn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    app:cardBackgroundColor="@color/streak_yellow"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="0dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/google_sans_bold"
                        android:gravity="center"
                        android:paddingVertical="16dp"
                        android:text="Suggest habits"
                        android:textColor="@color/black"
                        android:textSize="16sp" />

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <LinearLayout
                android:id="@+id/reply_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/free_prompt_layout"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="10dp"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="AI Recommended Habits"
                    android:textAppearance="@style/TextAppearance.Momentum.ItemTitle" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/ai_reply_rv"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp" />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/add_to_habits_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    app:cardBackgroundColor="@color/streak_yellow"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="0dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/google_sans_bold"
                        android:gravity="center"
                        android:paddingHorizontal="15dp"
                        android:paddingVertical="18dp"
                        android:text="Add to habits"
                        android:textColor="@color/black"
                        android:textSize="16sp" />

                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="8dp"
                    android:text="Or tap each habit to add them"
                    android:textAppearance="@style/TextAppearance.Momentum.BodySecondary" />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/clear_btn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    app:cardCornerRadius="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/google_sans_regular"
                        android:gravity="center"
                        android:padding="15dp"
                        android:text="Clear all"
                        android:textColor="@color/streak_orange"
                        android:textSize="15sp" />

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

        </RelativeLayout>

    </ScrollView>

    <!-- Declared after the ScrollView so it draws on top of the content.
         The brand flame replaces the old generic loader; it is already the
         app's motion identity on the splash and streak card. -->
    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/loading"
        android:layout_width="120dp"
        android:layout_height="150dp"
        android:layout_centerInParent="true"
        android:visibility="gone"
        app:lottie_autoPlay="true"
        app:lottie_loop="true"
        app:lottie_rawRes="@raw/fire_lottie"
        tools:visibility="gone" />

</RelativeLayout>
