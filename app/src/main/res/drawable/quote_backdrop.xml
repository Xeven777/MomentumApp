<?xml version="1.0" encoding="utf-8"?>
<!--
  Sunset backdrop for the quote card, drawn as pure XML so the app stays
  offline. The base gradient runs dark-to-warm, and a radial layer adds the
  low sun glow so the card reads as a photograph rather than a flat fade.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <gradient
                android:angle="270"
                android:endColor="#4A2A12"
                android:startColor="#0C0906"
                android:type="linear" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <gradient
                android:centerColor="#99C97A2A"
                android:centerX="0.5"
                android:centerY="0.78"
                android:endColor="#00C97A2A"
                android:gradientRadius="75%p"
                android:startColor="#E8A34A26"
                android:type="radial" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <gradient
                android:angle="90"
                android:endColor="#00000000"
                android:startColor="#B3000000"
                android:type="linear" />
        </shape>
    </item>

</layer-list>
