<?xml version="1.0" encoding="utf-8"?>
<!-- Habits and settings are backed up; the encrypted API-key blob is not: the
     Keystore key that decrypts it is device-bound, so a restored copy would be
     undecryptable on any other device. -->
<full-backup-content>
    <exclude domain="sharedpref" path="momentum_secure.xml" />
</full-backup-content>
