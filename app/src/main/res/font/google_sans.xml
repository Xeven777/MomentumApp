<?xml version="1.0" encoding="utf-8"?>
<!--
    Google Sans, subsetted to Latin + General Punctuation and instanced to
    static weights (all variable axes pinned) so it renders identically on
    API 24 and above. Licence: SIL Open Font License 1.1 — see
    licenses/GoogleSans-OFL.txt
-->
<font-family xmlns:android="http://schemas.android.com/apk/res/android">
    <font
        android:font="@font/google_sans_regular"
        android:fontStyle="normal"
        android:fontWeight="400" />
    <font
        android:font="@font/google_sans_bold"
        android:fontStyle="normal"
        android:fontWeight="700" />
    <font
