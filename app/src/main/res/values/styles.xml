<resources>
    <!--
      Type scale.

      Only three static Google Sans weights ship with the app (regular, bold,
      black) — they are subsetted instances, not a variable font — so there is
      no Medium/SemiBold to introduce. Hierarchy therefore comes from size,
      colour, tracking and tabular figures rather than from new font binaries.
      Prefer these appearances over ad-hoc textSize/fontFamily pairs.
    -->

    <!-- Screen titles: "Settings", "Stats". -->
    <style name="TextAppearance.Momentum.ScreenTitle" parent="">
        <item name="android:fontFamily">@font/google_sans_bold</item>
        <item name="android:textSize">32sp</item>
        <item name="android:letterSpacing">-0.01</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <!-- Small all-caps group labels: "HABITS", "TASKS", "STREAK". -->
    <style name="TextAppearance.Momentum.SectionLabel" parent="">
        <item name="android:fontFamily">@font/google_sans_bold</item>
        <item name="android:textSize">12sp</item>
        <item name="android:letterSpacing">0.12</item>
        <item name="android:textColor">@color/secondary_text</item>
    </style>

    <!-- Large figures. Tabular figures keep the digits from shifting as they count. -->
    <style name="TextAppearance.Momentum.NumberHero" parent="">
        <item name="android:fontFamily">@font/google_sans_bold</item>
        <item name="android:textSize">54sp</item>
        <item name="android:letterSpacing">-0.02</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:fontFeatureSettings">tnum</item>
    </style>

    <style name="TextAppearance.Momentum.NumberStat" parent="">
        <item name="android:fontFamily">@font/google_sans_black</item>
        <item name="android:textSize">32sp</item>
        <item name="android:letterSpacing">-0.01</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:fontFeatureSettings">tnum</item>
    </style>

    <!-- The unit that sits beside a large figure, as in "0 of 1". -->
    <style name="TextAppearance.Momentum.NumberUnit" parent="">
        <item name="android:fontFamily">@font/google_sans_regular</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:fontFeatureSettings">tnum</item>
    </style>

    <!-- Title of a list row or settings entry. -->
    <style name="TextAppearance.Momentum.ItemTitle" parent="">
        <item name="android:fontFamily">@font/google_sans_bold</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/white</item>
    </style>
    <style name="TextAppearance.Momentum.Wordmark" parent="">
        <item name="android:fontFamily">@font/google_sans_bold</item>
        <item name="android:textSize">36sp</item>
        <item name="android:letterSpacing">-0.035</item>
        <item name="android:textColor">@color/streak_yellow</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="TextAppearance.Momentum.BodySecondary" parent="">
        <item name="android:fontFamily">@font/google_sans_regular</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/secondary_text</item>
    </style>

    <!-- One tappable weekday circle in the habit add/edit dialog. -->
    <style name="DayToggle">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">38dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginStart">2dp</item>
        <item name="android:layout_marginEnd">2dp</item>
        <item name="android:background">@drawable/day_toggle_bg</item>
        <item name="android:fontFamily">@font/google_sans_bold</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/day_toggle_text</item>
        <item name="android:textSize">14sp</item>
    </style>
</resources>
