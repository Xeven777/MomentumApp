<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.Habits" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your light theme here. -->
        <!-- <item name="colorPrimary">@color/my_light_primary</item> -->
        <item name="materialCardViewStyle">@style/Widget.Momentum.Card</item>
    </style>

    <style name="Theme.Habits" parent="Base.Theme.Habits" />

    <!-- Light-mode defaults, matching what androidx CardView resolved on its
         own: white background, 2dp elevation. The night twin below pins the
         dark fallback (#FF424242) the same way CardView did. -->
    <style name="Widget.Momentum.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">#FFFFFFFF</item>
        <item name="cardElevation">2dp</item>
    </style>
</resources>