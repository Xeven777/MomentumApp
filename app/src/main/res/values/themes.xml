<resources xmlns:tools="http://schemas.android.com/tools">
    <!--
      Base application theme.

      The palette is declared once, here, and deliberately not overridden in
      values-night: a night-qualified style *replaces* this one rather than
      merging into it, so duplicating it would risk the two drifting apart.
      This app is a single dark surface in every configuration.
    -->
    <style name="Base.Theme.Habits" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Without this, every Material component (slider, switch, progress
             bar, dialog button, focused text-field outline) falls back to the
             stock Material 3 baseline purple. -->
        <item name="colorPrimary">@color/streak_yellow</item>
        <item name="colorOnPrimary">@color/black</item>
        <item name="colorSecondary">@color/streak_yellow</item>
        <item name="colorOnSecondary">@color/black</item>

        <!-- Neutral surfaces. The M3 default dark surface is purple-tinted
             (#141218), which is why dialogs and menus looked violet. -->
        <item name="android:colorBackground">@color/black</item>
        <!-- Pins the window behind the first frame so a cold start never
             flashes the light default before the first layout draws. -->
        <item name="android:windowBackground">@color/black</item>
        <item name="colorSurface">@color/dark_grey</item>
        <item name="colorOnSurface">@color/white</item>
        <item name="colorSurfaceVariant">@color/surface_row</item>
        <item name="colorOnSurfaceVariant">@color/secondary_text</item>
        <item name="colorOutline">@color/outline</item>

        <!-- Dialogs, menus and sheets draw on the surface-container ramp, which
             is also purple-tinted by default. Neutralise the whole ramp so a
             dialog matches the cards instead of looking violet. -->
        <item name="colorSurfaceContainerLow">@color/surface_row</item>
        <item name="colorSurfaceContainer">@color/surface_row</item>
        <item name="colorSurfaceContainerHigh">@color/dark_grey</item>
        <item name="colorSurfaceContainerHighest">@color/dark_grey</item>

        <item name="materialCardViewStyle">@style/Widget.Momentum.Card</item>
    </style>

    <style name="Theme.Habits" parent="Base.Theme.Habits" />

    <!-- Every card is this one surface colour: #313131, flat, no elevation.
         Cards that need a different tone (the streak card's yellow) set
         app:cardBackgroundColor themselves. -->
    <style name="Widget.Momentum.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/dark_grey</item>
        <item name="cardElevation">0dp</item>
    </style>
</resources>
